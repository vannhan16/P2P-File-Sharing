<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- Main Dashboard (Milestone 5): AtlantaFX UI, Host:Port Tunnel, Security PIN, WatchService, Drag&Drop, AreaChart & CSV History -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhannv.p2p.ui.MainController"
            prefWidth="1240" prefHeight="780">

    <!-- TOP: Application header + IP LAN / IP Radmin VPN display + 1-Click Firewall + Theme Switcher -->
    <top>
        <VBox style="-fx-background-color: #1f2937;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="10" right="16" bottom="6" left="16"/></padding>
                <Label text="P2P LAN &amp; Internet File Sharing"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="LAN • Radmin VPN • TCP Tunnel (host:port) • Security PIN • Swarm"
                       style="-fx-text-fill: #9ca3af;"/>
                <Label fx:id="networkIpBadgeLabel"
                       text="IP LAN: Đang dò... | IP Radmin VPN: Đang dò..."
                       HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER"
                       style="-fx-text-fill: #34d399; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Button fx:id="firewallConfigButton"
                        text="Cấu hình Firewall (1-Click)"
                        onAction="#handleConfigureFirewall"
                        styleClass="warning"/>
                <Button fx:id="themeToggleButton" text="Nord Dark"
                        onAction="#handleToggleTheme"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="0" right="16" bottom="8" left="16"/></padding>
                <Label fx:id="sharedFolderLabel" text="Thư mục chia sẻ: Shared/ (Tự động đồng bộ NIO WatchService)"
                       style="-fx-text-fill: #d1d5db; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT: Direct Host:Port Connect (Radmin VPN / Ngrok / Playit) + Security PIN + Online Peers + Drag&Drop Push -->
    <left>
        <VBox spacing="8" minWidth="305" prefWidth="305" maxWidth="305">
            <padding><Insets top="12" right="8" bottom="12" left="12"/></padding>

            <!-- TÁC VỤ 1.1: Ô nhập host:port kết nối trực tiếp xuyên Internet / Radmin VPN / LAN -->
            <Label text="Kết nối trực tiếp (IP / host:port)"
                   style="-fx-font-weight: bold;"/>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <TextField fx:id="directIpTextField"
                           promptText="vd: 26.x.x.x hoặc 0.tcp.ap.ngrok.io:14523"
                           onAction="#handleConnectDirectIp"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="connectDirectIpButton"
                        text="Kết nối"
                        onAction="#handleConnectDirectIp"
                        styleClass="success"/>
            </HBox>

            <!-- TÁC VỤ 1.2: Security PIN (Xác thực 4 chữ số bảo vệ máy & nhập PIN đối tác) -->
            <VBox spacing="5" style="-fx-background-color: rgba(99, 102, 241, 0.10); -fx-padding: 8; -fx-background-radius: 6;">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <CheckBox fx:id="pinEnableCheckBox"
                              text="Bật mã PIN bảo vệ"
                              onAction="#handlePinConfigChanged"
                              style="-fx-font-weight: bold;"/>
                    <TextField fx:id="myPinTextField"
                               promptText="4 số"
                               prefWidth="75"
                               onKeyReleased="#handlePinConfigChanged"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="PIN đối tác:" style="-fx-font-size: 12px;"/>
                    <TextField fx:id="peerPinTextField"
                               promptText="Nhập PIN (nếu Peer bật khóa)"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Peers đang online"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="peerCountLabel" text="(0)"/>
            </HBox>

            <ListView fx:id="peerListView" VBox.vgrow="ALWAYS"/>
            <Label text="Mẹo: Kéo thả tệp trực tiếp vào tên Peer để gửi ngay (Push)!"
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-opacity: 0.8;"/>
            <Button fx:id="deepScanButton"
                    text="Quét sâu mạng LAN / Radmin"
                    onAction="#handleDeepScanLan"
                    maxWidth="Infinity"
                    styleClass="accent"/>
        </VBox>
    </left>

    <!-- CENTER: TabPane gồm Tab 1 (Chia sẻ tệp, Drag&Drop, AreaChart tốc độ, Network Log) & Tab 2 (Lịch sử & Xuất CSV) -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: Chia sẻ tệp, Kéo thả (Drag & Drop), Biểu đồ tốc độ thời gian thực (AreaChart) & Nhật ký mạng -->
            <Tab text="Chia sẻ tệp &amp; Giám sát tốc độ">
                <VBox spacing="8">
                    <padding><Insets top="10" right="12" bottom="8" left="8"/></padding>

                    <!-- Thanh công cụ phía trên: Tìm kiếm + Chọn thư mục chia sẻ + Làm mới -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="searchTextField"
                                   promptText="Tìm kiếm tệp trên mạng LAN / Radmin / Internet (theo tên, Peer, hoặc SHA-256)..."
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="chooseSharedFolderButton"
                                text="Chọn thư mục chia sẻ"
                                onAction="#handleChooseSharedFolder"/>
                        <Button fx:id="refreshFilesButton"
                                text="Làm mới danh sách tệp"
                                onAction="#handleRefreshFiles"/>
                    </HBox>

                    <!-- Bảng danh sách tệp chia sẻ (Hỗ trợ Drag & Drop tệp từ Windows Explorer vào bảng để chia sẻ ngay) -->
                    <TableView fx:id="sharedFileTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="fileNameColumn" text="Tên tệp (Kéo thả tệp vào đây để chia sẻ)" prefWidth="230"/>
                            <TableColumn fx:id="fileSizeColumn" text="Dung lượng" prefWidth="95"/>
                            <TableColumn fx:id="fileSourcesColumn" text="Số nguồn (Peers)" prefWidth="120"/>
                            <TableColumn fx:id="fileOwnerColumn" text="Máy sở hữu (Endpoint)" prefWidth="195"/>
                            <TableColumn fx:id="fileHashColumn" text="Mã SHA-256" prefWidth="205"/>
                        </columns>
                    </TableView>

                    <!-- Khu vực dưới của Tab 1: Biểu đồ tốc độ AreaChart (30s) + Nhật ký sự kiện mạng -->
                    <HBox spacing="10" prefHeight="195" minHeight="175">
                        <!-- TÁC VỤ 3.2: Biểu đồ tốc độ truyền tải thời gian thực (AreaChart 30 giây gần nhất) -->
                        <VBox spacing="2" prefWidth="420" minWidth="360">
                            <Label text="Biểu đồ tốc độ truyền tải thời gian thực (MB/s - 30 giây)"
                                   style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <AreaChart fx:id="speedTelemetryChart"
                                       animated="false"
                                       legendVisible="false"
                                       createSymbols="false"
                                       VBox.vgrow="ALWAYS">
                                <xAxis>
                                    <NumberAxis fx:id="speedTimeAxis"
                                                label="Thời gian (giây)"
                                                autoRanging="false"
                                                lowerBound="0"
                                                upperBound="30"
                                                tickUnit="5"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="speedValueAxis"
                                                label="MB/s"
                                                autoRanging="true"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </AreaChart>
                        </VBox>

                        <!-- Nhật ký sự kiện mạng (Live Network Event Log) -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Nhật ký sự kiện mạng (Real-time Network Log)"
                                       style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <Label text="(WatchService, PIN Auth, Tunnel host:port, Swarm)"
                                       style="-fx-font-size: 11px;"/>
                            </HBox>
                            <TextArea fx:id="networkLogArea"
                                      editable="false"
                                      wrapText="true"
                                      VBox.vgrow="ALWAYS"
                                      style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 2: Lịch sử truyền tải & Xuất báo cáo hiệu năng CSV (TÁC VỤ 4) -->
            <Tab text="Lịch sử &amp; Thống kê">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="10" left="10"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Thống kê hiệu năng truyền tải tệp (Gửi / Nhận / Swarm)"
                               style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label fx:id="historyCountLabel"
                               text="(0 phiên hoàn tất)"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="exportCsvButton"
                                text="Xuất báo cáo CSV"
                                onAction="#handleExportCsv"
                                styleClass="success"/>
                    </HBox>

                    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="historyTimeColumn" text="Thời gian" prefWidth="135"/>
                            <TableColumn fx:id="historyFileColumn" text="Tên tệp" prefWidth="180"/>
                            <TableColumn fx:id="historySizeColumn" text="Dung lượng" prefWidth="95"/>
                            <TableColumn fx:id="historyPeerColumn" text="Peer đối tác" prefWidth="150"/>
                            <TableColumn fx:id="historyDirectionColumn" text="Chiều truyền" prefWidth="115"/>
                            <TableColumn fx:id="historySpeedColumn" text="Tốc độ TB (MB/s)" prefWidth="115"/>
                            <TableColumn fx:id="historyDurationColumn" text="Thời gian hoàn thành" prefWidth="125"/>
                            <TableColumn fx:id="historyHashStatusColumn" text="Kết quả SHA-256" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- BOTTOM: Transfer controls (Download, Pause, Resume, Cancel, Push), status & progress bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="10" right="16" bottom="12" left="16"/></padding>
            <Button fx:id="downloadSelectedButton"
                    text="Tải tệp đã chọn"
                    onAction="#handleDownloadSelectedFile"
                    defaultButton="true"
                    styleClass="accent"/>
            <Button fx:id="pauseButton"
                    text="Tạm dừng (Pause)"
                    onAction="#handlePauseDownload"/>
            <Button fx:id="resumeButton"
                    text="Tiếp tục (Resume)"
                    onAction="#handleResumeDownload"
                    styleClass="success"/>
            <Button fx:id="cancelButton"
                    text="Hủy (Cancel)"
                    onAction="#handleCancelDownload"
                    styleClass="danger"/>
            <Button fx:id="chooseFileButton"
                    text="Chọn file (Push)"
                    onAction="#handleChooseFile"/>
            <Label fx:id="statusLabel" text="Trạng thái: Sẵn sàng" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <ProgressBar fx:id="transferProgressBar" progress="0.0" prefWidth="210"/>
        </HBox>
    </bottom>
</BorderPane>
