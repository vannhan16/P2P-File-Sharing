<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Main Dashboard (Milestone 4): AtlantaFX UI, Swarm Peer Counter, Pause/Resume/Cancel & Live Network Log -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhannv.p2p.ui.MainController"
            prefWidth="1080" prefHeight="720">

    <!-- TOP: Application header + Shared Folder indicator + Theme Switcher -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #1f2937;">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="P2P LAN File Sharing"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Swarm • Pause/Resume • SHA-256"
                   style="-fx-text-fill: #9ca3af;"/>
            <Label fx:id="sharedFolderLabel" text="Thư mục chia sẻ: Shared/"
                   HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER_RIGHT"
                   style="-fx-text-fill: #d1d5db; -fx-font-size: 12px;"/>
            <Button fx:id="themeToggleButton" text="Nord Dark"
                    onAction="#handleToggleTheme"/>
        </HBox>
    </top>

    <!-- LEFT: Online peers in the LAN -->
    <left>
        <VBox spacing="8" minWidth="240" prefWidth="240" maxWidth="240">
            <padding><Insets top="12" right="8" bottom="12" left="12"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Peers đang online"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="peerCountLabel" text="(0)"/>
            </HBox>
            <ListView fx:id="peerListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- CENTER: Search bar + Shared folder controls + SharedFile TableView + Live Network Log -->
    <center>
        <VBox spacing="10">
            <padding><Insets top="12" right="12" bottom="8" left="8"/></padding>

            <!-- Thanh công cụ phía trên vùng giữa: Tìm kiếm + Chọn thư mục chia sẻ + Làm mới -->
            <HBox alignment="CENTER_LEFT" spacing="8">
                <TextField fx:id="searchTextField"
                           promptText="Tìm kiếm tệp trên mạng LAN (theo tên, Peer, hoặc SHA-256)..."
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="chooseSharedFolderButton"
                        text="Chọn thư mục chia sẻ"
                        onAction="#handleChooseSharedFolder"/>
                <Button fx:id="refreshFilesButton"
                        text="Làm mới danh sách tệp"
                        onAction="#handleRefreshFiles"/>
            </HBox>

            <!-- Bảng danh sách tệp chia sẻ (tự động gộp các tệp trùng SHA-256 và hiển thị Số nguồn Peers) -->
            <TableView fx:id="sharedFileTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="fileNameColumn" text="Tên tệp" prefWidth="210"/>
                    <TableColumn fx:id="fileSizeColumn" text="Dung lượng" prefWidth="95"/>
                    <TableColumn fx:id="fileSourcesColumn" text="Số nguồn (Peers)" prefWidth="125"/>
                    <TableColumn fx:id="fileOwnerColumn" text="Máy sở hữu (Peer)" prefWidth="190"/>
                    <TableColumn fx:id="fileHashColumn" text="Mã SHA-256" prefWidth="210"/>
                </columns>
            </TableView>

            <!-- Khu vực Nhật ký sự kiện mạng (Live Network Event Log) phục vụ thuyết trình đồ án -->
            <VBox spacing="4" prefHeight="155" minHeight="130">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Nhật ký sự kiện mạng (Real-time Network Log)"
                           style="-fx-font-weight: bold;"/>
                    <Label text="(Ghi nhận Offset, Pause/Resume, Multi-source Swarm &amp; SHA-256)"
                           style="-fx-font-size: 11px;"/>
                </HBox>
                <TextArea fx:id="networkLogArea"
                          editable="false"
                          wrapText="true"
                          VBox.vgrow="ALWAYS"
                          style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </center>

    <!-- BOTTOM: Transfer controls (Download, Pause, Resume, Cancel, Push), status & progress bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="8">
            <padding><Insets top="10" right="16" bottom="12" left="16"/></padding>
            <Button fx:id="downloadSelectedButton"
                    text="Tải tệp đã chọn"
                    onAction="#handleDownloadSelectedFile"
                    defaultButton="true"
                    styleClass="accent"/>
            <Button fx:id="pauseButton"
                    text="Tạm dừng (Pause)"
                    onAction="#handlePauseDownload"/>
            <Button fx:id="resumeButton"
                    text="Tiếp tục (Resume)"
                    onAction="#handleResumeDownload"
                    styleClass="success"/>
            <Button fx:id="cancelButton"
                    text="Hủy (Cancel)"
                    onAction="#handleCancelDownload"
                    styleClass="danger"/>
            <Button fx:id="chooseFileButton"
                    text="Chọn file (Push)"
                    onAction="#handleChooseFile"/>
            <Label fx:id="statusLabel" text="Trạng thái: Sẵn sàng" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <ProgressBar fx:id="transferProgressBar" progress="0.0" prefWidth="210"/>
        </HBox>
    </bottom>
</BorderPane>
