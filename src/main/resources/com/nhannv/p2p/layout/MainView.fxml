<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Crafted Desktop UI (Linear / LocalSend / Fluent Design System) - Zero Inline Styles -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhannv.p2p.ui.MainController"
            prefWidth="1320" prefHeight="820">

    <!-- 1. TOP HEADER BAR (52px): Brand + Server Status + Network Identity Pills + Firewall & Theme Toggle -->
    <top>
        <HBox styleClass="top-header-bar" alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="brandTitleLabel"
                   text="P2P LAN &amp; Tunnel File Sharing"
                   styleClass="app-brand-title"/>
            <Label fx:id="serverStatusPill"
                   text="TCP :8889 ONLINE"
                   styleClass="network-pill, pill-online"/>

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Network Identity Pills (Monospace) -->
            <Label fx:id="lanIpPillLabel"
                   text="LAN: 127.0.0.1"
                   styleClass="network-pill, pill-sync"/>
            <Label fx:id="radminIpPillLabel"
                   text="Radmin: OFF"
                   styleClass="network-pill, pill-neutral"/>
            <Label fx:id="pinStatusPillLabel"
                   text="PIN: OFF"
                   styleClass="network-pill, pill-neutral"/>

            <Button fx:id="firewallConfigButton"
                    text="Firewall (1-Click)"
                    onAction="#handleConfigureFirewall"
                    styleClass="button-outlined"/>
            <Button fx:id="themeToggleButton"
                    text="Light Mode"
                    onAction="#handleToggleTheme"
                    styleClass="button-outlined"/>
        </HBox>
    </top>

    <!-- 2. LEFT SIDEBAR - DEVICE RADAR (280px, Surface 1) -->
    <left>
        <VBox styleClass="sidebar-radar" spacing="10" minWidth="285" prefWidth="285" maxWidth="285">

            <!-- Direct Connect InputGroup (host:port or Invite Token host:port#PIN) -->
            <Label text="KẾT NỐI NHANH (IP:PORT / #PIN)" styleClass="section-header"/>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <TextField fx:id="directIpTextField"
                           promptText="26.x.x.x:8889#PIN hoặc ngrok..."
                           onAction="#handleConnectDirectIp"
                           styleClass="mono-text"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="connectDirectIpButton"
                        text="Kết nối"
                        onAction="#handleConnectDirectIp"
                        styleClass="accent"/>
            </HBox>

            <!-- Security PIN & Invite Token Card -->
            <VBox styleClass="surface-card" spacing="7">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <CheckBox fx:id="pinEnableCheckBox"
                              text="Khóa PIN"
                              onAction="#handlePinConfigChanged"/>
                    <TextField fx:id="myPinTextField"
                               promptText="4 số"
                               prefWidth="64"
                               styleClass="mono-text"
                               onKeyReleased="#handlePinConfigChanged"/>
                    <Button fx:id="copyInviteTokenButton"
                            text="Mã Mời"
                            onAction="#handleCopyInviteToken"
                            styleClass="button-outlined"
                            HBox.hgrow="ALWAYS"
                            maxWidth="Infinity"/>
                </HBox>
                <CheckBox fx:id="askPushConfirmCheckBox"
                          text="Hỏi xác nhận khi nhận tệp Push"
                          onAction="#handlePushConfirmConfigChanged"
                          styleClass="subtle-caption"/>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="PIN đối tác:" styleClass="subtle-caption"/>
                    <TextField fx:id="peerPinTextField"
                               promptText="Tự điền khi dán Mã Mời"
                               styleClass="mono-text"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Radar Peers Header -->
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="RADAR THIẾT BỊ ONLINE" styleClass="section-header"/>
                <Label fx:id="peerCountLabel" text="(0)" styleClass="mono-text"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deepScanButton"
                        text="Quét LAN"
                        onAction="#handleDeepScanLan"
                        styleClass="flat"/>
            </HBox>

            <!-- Custom ListCell<Peer> Card List -->
            <ListView fx:id="peerListView"
                      styleClass="peer-radar-list"
                      VBox.vgrow="ALWAYS"/>

            <Label fx:id="sharedFolderLabel"
                   text="Shared: ./Shared (NIO WatchService)"
                   wrapText="true"
                   styleClass="subtle-caption"/>
        </VBox>
    </left>

    <!-- 3. CENTER WORKSPACE - FILE MANAGEMENT, BITTORRENT MATRIX, CSV HISTORY & P2P CHAT -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: Quản lý Tệp chia sẻ, Bản đồ 32 mảnh Swarm & Nhật ký mạng -->
            <Tab text="Kho Tệp Chia Sẻ &amp; Radar Mảnh Tải">
                <VBox styleClass="center-workspace" spacing="10">

                    <!-- Flat Toolbar: Search Input with Icon + Secondary Action Buttons -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <HBox styleClass="search-input-box" alignment="CENTER_LEFT" spacing="6" HBox.hgrow="ALWAYS">
                            <Label fx:id="searchIconHolder"/>
                            <TextField fx:id="searchTextField"
                                       promptText="Tìm kiếm theo tên tệp, máy sở hữu hoặc mã băm SHA-256..."
                                       styleClass="search-input-field"
                                       HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Button fx:id="shareFolderZipButton"
                                text="Chia sẻ Thư mục (ZIP)"
                                onAction="#handleShareDirectoryAsZip"
                                styleClass="button-outlined"/>
                        <Button fx:id="chooseSharedFolderButton"
                                text="Đổi Thư mục Shared"
                                onAction="#handleChooseSharedFolder"
                                styleClass="button-outlined"/>
                        <Button fx:id="refreshFilesButton"
                                text="Làm mới"
                                onAction="#handleRefreshFiles"
                                styleClass="flat"/>
                    </HBox>

                    <!-- Crafted TableView (40px rows, no vertical lines, right-aligned size, SHA-256 code pill) -->
                    <TableView fx:id="sharedFileTable" styleClass="crafted-table" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="fileNameColumn" text="Tên tệp / Thư mục nén" prefWidth="250"/>
                            <TableColumn fx:id="fileSizeColumn" text="Dung lượng" prefWidth="105"/>
                            <TableColumn fx:id="fileSourcesColumn" text="Nguồn tải (Swarm)" prefWidth="130"/>
                            <TableColumn fx:id="fileOwnerColumn" text="Thiết bị sở hữu (Endpoint)" prefWidth="200"/>
                            <TableColumn fx:id="fileHashColumn" text="Toàn vẹn SHA-256 (Click để Copy)" prefWidth="190"/>
                        </columns>
                    </TableView>

                    <!-- BitTorrent 32-Chunk Matrix Panel -->
                    <VBox styleClass="chunk-matrix-panel" spacing="5">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <Label text="BẢN ĐỒ 32 PHÂN ĐOẠN TẢI (BITTORRENT CHUNK MATRIX)" styleClass="section-header"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="■ Chưa tải" styleClass="legend-waiting"/>
                            <Label text="■ Đang tải (Peer 1)" styleClass="legend-primary"/>
                            <Label text="■ Swarm (Peer 2+)" styleClass="legend-swarm"/>
                            <Label text="■ Hoàn tất (.part)" styleClass="legend-completed"/>
                            <Label text="■ Tạm dừng / Failover" styleClass="legend-error"/>
                        </HBox>
                        <HBox fx:id="chunkMatrixContainer" spacing="3" alignment="CENTER_LEFT" prefHeight="14"/>
                    </VBox>

                    <!-- Live Network Telemetry Log -->
                    <VBox spacing="4" prefHeight="135" minHeight="115">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="NHẬT KÝ SỰ KIỆN MẠNG THỜI GIAN THỰC (NETWORK TELEMETRY LOG)" styleClass="section-header"/>
                        </HBox>
                        <TextArea fx:id="networkLogArea"
                                  editable="false"
                                  wrapText="true"
                                  styleClass="telemetry-log-area"
                                  VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>
            </Tab>

            <!-- TAB 2: Lịch sử truyền tải & Xuất báo cáo hiệu năng CSV -->
            <Tab text="Lịch Sử Truyền Tải &amp; Báo Cáo CSV">
                <VBox styleClass="center-workspace" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="THỐNG KÊ HIỆU NĂNG TRUYỀN TẢI (PULL / PUSH / SWARM)" styleClass="section-header"/>
                        <Label fx:id="historyCountLabel"
                               text="(0 phiên hoàn tất)"
                               styleClass="mono-text"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="exportCsvButton"
                                text="Xuất báo cáo CSV"
                                onAction="#handleExportCsv"
                                styleClass="accent"/>
                    </HBox>

                    <TableView fx:id="historyTable" styleClass="crafted-table" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="historyTimeColumn" text="Thời gian" prefWidth="135"/>
                            <TableColumn fx:id="historyFileColumn" text="Tên tệp" prefWidth="185"/>
                            <TableColumn fx:id="historySizeColumn" text="Dung lượng" prefWidth="95"/>
                            <TableColumn fx:id="historyPeerColumn" text="Peer đối tác" prefWidth="150"/>
                            <TableColumn fx:id="historyDirectionColumn" text="Chiều truyền" prefWidth="120"/>
                            <TableColumn fx:id="historySpeedColumn" text="Tốc độ TB" prefWidth="110"/>
                            <TableColumn fx:id="historyDurationColumn" text="Thời gian" prefWidth="110"/>
                            <TableColumn fx:id="historyHashStatusColumn" text="Toàn vẹn SHA-256" prefWidth="135"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 3: Kênh Chat P2P Bảo mật Đầu-Cuối AES-256-GCM -->
            <Tab text="Kênh Chat P2P (AES-256-GCM)">
                <VBox styleClass="center-workspace" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="GIAO TIẾP P2P TỨC THỜI — MÃ HÓA ĐẦU-CUỐI AES-256-GCM (PBKDF2 + 12-BYTE IV)"
                               styleClass="section-header"/>
                    </HBox>

                    <TextArea fx:id="chatHistoryArea"
                              editable="false"
                              wrapText="true"
                              promptText="Tin nhắn P2P được mã hóa AES-256-GCM giữa bạn và các Peer sẽ hiển thị tại đây..."
                              styleClass="telemetry-log-area"
                              VBox.vgrow="ALWAYS"/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="chatInputField"
                                   promptText="Nhập tin nhắn, mã mời hoặc đoạn cấu hình cần gửi nhanh cho Peer..."
                                   onAction="#handleSendChatMessage"
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="sendChatButton"
                                text="Gửi tới Peer đang chọn"
                                onAction="#handleSendChatMessage"
                                styleClass="accent"/>
                        <Button fx:id="broadcastChatButton"
                                text="Gửi Broadcast toàn mạng"
                                onAction="#handleBroadcastChatMessage"
                                styleClass="button-outlined"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- 4. BOTTOM TRANSFER DOCK: Left (Transfer Status + 6px Progress + QoS) | Center (Smooth AreaChart) | Right (Action Hierarchy) -->
    <bottom>
        <HBox styleClass="bottom-transfer-dock" alignment="CENTER_LEFT" spacing="16" prefHeight="96">

            <!-- Left Dock: Active Transfer Status + Thin 6px ProgressBar + QoS Limiter -->
            <VBox spacing="6" prefWidth="360" minWidth="320" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="statusLabel"
                           text="Trạng thái: Sẵn sàng"
                           HBox.hgrow="ALWAYS"
                           maxWidth="Infinity"/>
                    <Label fx:id="liveSpeedBadgeLabel"
                           text="0.00 MB/s"
                           styleClass="mono-metric-large"/>
                </HBox>
                <ProgressBar fx:id="transferProgressBar"
                             progress="0.0"
                             maxWidth="Infinity"
                             styleClass="thin-progress-bar"/>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="Giới hạn băng thông (QoS):" styleClass="subtle-caption"/>
                    <ComboBox fx:id="bandwidthLimitComboBox"
                              onAction="#handleBandwidthLimitChanged"
                              prefWidth="140"/>
                </HBox>
            </VBox>

            <!-- Center Dock: Smooth Real-time Speed AreaChart (30s Sliding Window, Minimal Chrome) -->
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS" prefHeight="76" maxHeight="80">
                <AreaChart fx:id="speedTelemetryChart"
                           animated="false"
                           legendVisible="false"
                           createSymbols="false"
                           horizontalGridLinesVisible="true"
                           verticalGridLinesVisible="false"
                           styleClass="dock-telemetry-chart"
                           VBox.vgrow="ALWAYS">
                    <xAxis>
                        <NumberAxis fx:id="speedTimeAxis"
                                    autoRanging="false"
                                    lowerBound="0"
                                    upperBound="30"
                                    tickUnit="10"
                                    tickLabelsVisible="false"
                                    tickMarkVisible="false"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis fx:id="speedValueAxis"
                                    autoRanging="true"
                                    forceZeroInRange="true"
                                    tickLabelsVisible="true"/>
                    </yAxis>
                </AreaChart>
            </VBox>

            <!-- Right Dock: Strict Button Hierarchy (1 Primary Accent + Secondary Outlined + Ghost Controls) -->
            <HBox alignment="CENTER_RIGHT" spacing="7">
                <Button fx:id="downloadSelectedButton"
                        text="Tải tệp"
                        onAction="#handleDownloadSelectedFile"
                        defaultButton="true"
                        styleClass="accent"/>
                <Button fx:id="chooseFileButton"
                        text="Gửi tệp"
                        onAction="#handleChooseFile"
                        styleClass="button-outlined"/>
                <Button fx:id="pushFolderButton"
                        text="Gửi Thư mục"
                        onAction="#handlePushDirectory"
                        styleClass="button-outlined"/>

                <Button fx:id="pauseButton"
                        text="Tạm dừng"
                        onAction="#handlePauseDownload"
                        styleClass="flat"/>
                <Button fx:id="resumeButton"
                        text="Tiếp tục"
                        onAction="#handleResumeDownload"
                        styleClass="flat"/>
                <Button fx:id="cancelButton"
                        text="Hủy"
                        onAction="#handleCancelDownload"
                        styleClass="flat"/>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>
