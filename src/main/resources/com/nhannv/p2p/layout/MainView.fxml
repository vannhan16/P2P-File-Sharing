<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Main Dashboard (Milestone 6 Enterprise Edition): Host:Port#PIN Invite, AES-256-GCM, BitTorrent 32-Chunk Matrix, Folder ZIP Streaming, QoS Limiter & P2P Chat -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhannv.p2p.ui.MainController"
            prefWidth="1280" prefHeight="800">

    <!-- TOP: Application header + IP LAN / IP Radmin VPN display + 1-Click Firewall + Theme Switcher -->
    <top>
        <VBox style="-fx-background-color: #1f2937;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding><Insets top="10" right="16" bottom="6" left="16"/></padding>
                <Label text="P2P LAN &amp; Internet File Sharing"
                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
                <Label text="M6 Enterprise: AES-256-GCM • BitTorrent Chunk Matrix • Folder ZIP • QoS • P2P Chat"
                       style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
                <Label fx:id="networkIpBadgeLabel"
                       text="IP LAN: Đang dò... | IP Radmin VPN: Đang dò..."
                       HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER"
                       style="-fx-text-fill: #34d399; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Button fx:id="firewallConfigButton"
                        text="Cấu hình Firewall (1-Click)"
                        onAction="#handleConfigureFirewall"
                        styleClass="warning"/>
                <Button fx:id="themeToggleButton" text="Nord Dark"
                        onAction="#handleToggleTheme"/>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <padding><Insets top="0" right="16" bottom="8" left="16"/></padding>
                <Label fx:id="sharedFolderLabel" text="Thư mục chia sẻ: Shared/ (Tự động đồng bộ NIO WatchService)"
                       style="-fx-text-fill: #d1d5db; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- LEFT: Direct Host:Port#PIN Connect + Security PIN & Push Approval + Online Peers (with RTT ms) -->
    <left>
        <VBox spacing="7" minWidth="315" prefWidth="315" maxWidth="315">
            <padding><Insets top="10" right="8" bottom="10" left="12"/></padding>

            <!-- Kết nối trực tiếp qua IP / host:port hoặc Mã mời nhanh host:port#PIN -->
            <Label text="Kết nối trực tiếp (host:port hoặc Mã mời #PIN)"
                   style="-fx-font-weight: bold; -fx-font-size: 12.5px;"/>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <TextField fx:id="directIpTextField"
                           promptText="vd: 26.x.x.x:8889#1234 hoặc ngrok.io:14523"
                           onAction="#handleConnectDirectIp"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="connectDirectIpButton"
                        text="Kết nối"
                        onAction="#handleConnectDirectIp"
                        styleClass="success"/>
            </HBox>

            <!-- Khối Bảo mật PIN 4 số + Hỏi xác nhận khi nhận Push + Copy Mã Mời 1-Click -->
            <VBox spacing="5" style="-fx-background-color: rgba(99, 102, 241, 0.10); -fx-padding: 8; -fx-background-radius: 6;">
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <CheckBox fx:id="pinEnableCheckBox"
                              text="Bật mã PIN bảo vệ"
                              onAction="#handlePinConfigChanged"
                              style="-fx-font-weight: bold;"/>
                    <TextField fx:id="myPinTextField"
                               promptText="4 số"
                               prefWidth="68"
                               onKeyReleased="#handlePinConfigChanged"/>
                    <Button fx:id="copyInviteTokenButton"
                            text="Copy Mã Mời"
                            onAction="#handleCopyInviteToken"
                            style="-fx-font-size: 11px;"/>
                </HBox>
                <CheckBox fx:id="askPushConfirmCheckBox"
                          text="Hỏi xác nhận trước khi nhận tệp Push"
                          onAction="#handlePushConfirmConfigChanged"
                          style="-fx-font-size: 11.5px;"/>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="PIN đối tác:" style="-fx-font-size: 12px;"/>
                    <TextField fx:id="peerPinTextField"
                               promptText="Nhập PIN (tự điền khi dán Mã Mời)"
                               HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Peers đang online (kèm Ping RTT ms)"
                       style="-fx-font-weight: bold;"/>
                <Label fx:id="peerCountLabel" text="(0)"/>
            </HBox>

            <ListView fx:id="peerListView" VBox.vgrow="ALWAYS"/>
            <Label text="Mẹo: Kéo thả Tệp hoặc cả Thư mục vào tên Peer để gửi ngay!"
                   wrapText="true"
                   style="-fx-font-size: 11px; -fx-opacity: 0.85;"/>
            <Button fx:id="deepScanButton"
                    text="Quét sâu mạng LAN / Radmin"
                    onAction="#handleDeepScanLan"
                    maxWidth="Infinity"
                    styleClass="accent"/>
        </VBox>
    </left>

    <!-- CENTER: TabPane gồm 3 Tab: (1) Chia sẻ & Giám sát, (2) Lịch sử & CSV, (3) Chat P2P Bảo mật AES-256-GCM -->
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- TAB 1: Chia sẻ tệp/thư mục, BitTorrent 32-Chunk Matrix, AreaChart tốc độ & Network Log -->
            <Tab text="Chia sẻ tệp &amp; Bản đồ mảnh Swarm">
                <VBox spacing="7">
                    <padding><Insets top="8" right="12" bottom="6" left="8"/></padding>

                    <!-- Thanh công cụ phía trên: Tìm kiếm + Đóng gói Thư mục ZIP + Chọn thư mục chia sẻ + Làm mới -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="searchTextField"
                                   promptText="Tìm kiếm tệp trên mạng LAN / Radmin / Internet (theo tên, Peer, hoặc SHA-256)..."
                                   HBox.hgrow="ALWAYS"/>
                        <Button fx:id="shareFolderZipButton"
                                text="Chia sẻ cả Thư mục (ZIP)"
                                onAction="#handleShareDirectoryAsZip"
                                styleClass="accent"/>
                        <Button fx:id="chooseSharedFolderButton"
                                text="Đổi thư mục Shared"
                                onAction="#handleChooseSharedFolder"/>
                        <Button fx:id="refreshFilesButton"
                                text="Làm mới"
                                onAction="#handleRefreshFiles"/>
                    </HBox>

                    <!-- Bảng danh sách tệp chia sẻ (Hỗ trợ Drag & Drop cả Tệp lẫn Thư mục vào bảng) -->
                    <TableView fx:id="sharedFileTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="fileNameColumn" text="Tên tệp (Kéo thả Tệp hoặc Thư mục vào đây)" prefWidth="235"/>
                            <TableColumn fx:id="fileSizeColumn" text="Dung lượng" prefWidth="90"/>
                            <TableColumn fx:id="fileSourcesColumn" text="Số nguồn (Peers)" prefWidth="115"/>
                            <TableColumn fx:id="fileOwnerColumn" text="Máy sở hữu (Endpoint)" prefWidth="195"/>
                            <TableColumn fx:id="fileHashColumn" text="Mã SHA-256" prefWidth="200"/>
                        </columns>
                    </TableView>

                    <!-- GÓI 2 (MILESTONE 6): Bản đồ 32 mảnh tải thời gian thực (BitTorrent Chunk Matrix UI) -->
                    <VBox spacing="3" style="-fx-background-color: rgba(15, 23, 42, 0.06); -fx-padding: 6 8 6 8; -fx-background-radius: 6;">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <Label text="Bản đồ 32 phân đoạn tải (BitTorrent Chunk Matrix):"
                                   style="-fx-font-weight: bold; -fx-font-size: 11.5px;"/>
                            <Label text="■ Chưa tải" style="-fx-text-fill: #9ca3af; -fx-font-size: 11px;"/>
                            <Label text="■ Đang tải (Peer 1)" style="-fx-text-fill: #3b82f6; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <Label text="■ Đang tải (Swarm Peer 2+)" style="-fx-text-fill: #f59e0b; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <Label text="■ Hoàn tất (.part)" style="-fx-text-fill: #10b981; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                            <Label text="■ Tạm dừng / Failover" style="-fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-font-size: 11px;"/>
                        </HBox>
                        <HBox fx:id="chunkMatrixContainer" spacing="3" alignment="CENTER_LEFT" prefHeight="18"/>
                    </VBox>

                    <!-- Khu vực dưới của Tab 1: Biểu đồ tốc độ AreaChart (30s) + Nhật ký sự kiện mạng -->
                    <HBox spacing="10" prefHeight="180" minHeight="160">
                        <VBox spacing="2" prefWidth="410" minWidth="350">
                            <Label text="Biểu đồ tốc độ truyền tải thời gian thực (MB/s - 30 giây)"
                                   style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                            <AreaChart fx:id="speedTelemetryChart"
                                       animated="false"
                                       legendVisible="false"
                                       createSymbols="false"
                                       VBox.vgrow="ALWAYS">
                                <xAxis>
                                    <NumberAxis fx:id="speedTimeAxis"
                                                label="Thời gian (giây)"
                                                autoRanging="false"
                                                lowerBound="0"
                                                upperBound="30"
                                                tickUnit="5"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="speedValueAxis"
                                                label="MB/s"
                                                autoRanging="true"
                                                forceZeroInRange="true"/>
                                </yAxis>
                            </AreaChart>
                        </VBox>

                        <!-- Nhật ký sự kiện mạng (Live Network Event Log) -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="Nhật ký sự kiện mạng (Real-time Network Log)"
                                       style="-fx-font-weight: bold; -fx-font-size: 12px;"/>
                                <Label text="(WatchService, PIN, Swarm Failover, QoS, AES-256)"
                                       style="-fx-font-size: 11px;"/>
                            </HBox>
                            <TextArea fx:id="networkLogArea"
                                      editable="false"
                                      wrapText="true"
                                      VBox.vgrow="ALWAYS"
                                      style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </Tab>

            <!-- TAB 2: Lịch sử truyền tải & Xuất báo cáo hiệu năng CSV -->
            <Tab text="Lịch sử &amp; Thống kê (CSV)">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="10" left="10"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Thống kê hiệu năng truyền tải tệp (Gửi / Nhận / Swarm)"
                               style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label fx:id="historyCountLabel"
                               text="(0 phiên hoàn tất)"
                               HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button fx:id="exportCsvButton"
                                text="Xuất báo cáo CSV"
                                onAction="#handleExportCsv"
                                styleClass="success"/>
                    </HBox>

                    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS">
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="historyTimeColumn" text="Thời gian" prefWidth="135"/>
                            <TableColumn fx:id="historyFileColumn" text="Tên tệp" prefWidth="180"/>
                            <TableColumn fx:id="historySizeColumn" text="Dung lượng" prefWidth="95"/>
                            <TableColumn fx:id="historyPeerColumn" text="Peer đối tác" prefWidth="150"/>
                            <TableColumn fx:id="historyDirectionColumn" text="Chiều truyền" prefWidth="115"/>
                            <TableColumn fx:id="historySpeedColumn" text="Tốc độ TB (MB/s)" prefWidth="115"/>
                            <TableColumn fx:id="historyDurationColumn" text="Thời gian hoàn thành" prefWidth="125"/>
                            <TableColumn fx:id="historyHashStatusColumn" text="Kết quả SHA-256" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- TAB 3 (MILESTONE 6 - GÓI 1 & GÓI 5): Kênh Chat P2P Tức thời Mã hóa Đầu-Cuối AES-256-GCM -->
            <Tab text="Chat P2P Bảo mật (AES-256-GCM)">
                <VBox spacing="10">
                    <padding><Insets top="12" right="12" bottom="10" left="10"/></padding>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Kênh Giao tiếp P2P Tức thời — Mã hóa đầu-cuối AES-256-GCM (PBKDF2 + 12-byte IV)"
                               style="-fx-font-weight: bold; -fx-font-size: 13.5px;"/>
                    </HBox>

                    <TextArea fx:id="chatHistoryArea"
                              editable="false"
                              wrapText="true"
                              promptText="Tin nhắn P2P được mã hóa AES-256-GCM giữa bạn và các Peer sẽ hiển thị tại đây..."
                              VBox.vgrow="ALWAYS"
                              style="-fx-font-family: 'Consolas', 'Monospaced'; -fx-font-size: 13px;"/>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <TextField fx:id="chatInputField"
                                   promptText="Nhập tin nhắn, mã PIN hoặc dán đoạn code/link cần gửi nhanh cho Peer..."
                                   onAction="#handleSendChatMessage"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="Gửi tới Peer đang chọn"
                                onAction="#handleSendChatMessage"
                                styleClass="accent"/>
                        <Button text="Gửi toàn mạng (Broadcast)"
                                onAction="#handleBroadcastChatMessage"
                                styleClass="success"/>
                    </HBox>
                </VBox>
            </Tab>
        </TabPane>
    </center>

    <!-- BOTTOM: Transfer controls (Download, Pause, Resume, Cancel, Push File, Push Folder, QoS Limiter), status & progress bar -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="7">
            <padding><Insets top="8" right="16" bottom="10" left="16"/></padding>
            <Button fx:id="downloadSelectedButton"
                    text="Tải tệp đã chọn"
                    onAction="#handleDownloadSelectedFile"
                    defaultButton="true"
                    styleClass="accent"/>
            <Button fx:id="pauseButton"
                    text="Tạm dừng"
                    onAction="#handlePauseDownload"/>
            <Button fx:id="resumeButton"
                    text="Tiếp tục"
                    onAction="#handleResumeDownload"
                    styleClass="success"/>
            <Button fx:id="cancelButton"
                    text="Hủy"
                    onAction="#handleCancelDownload"
                    styleClass="danger"/>
            <Button fx:id="chooseFileButton"
                    text="Gửi tệp (Push)"
                    onAction="#handleChooseFile"/>
            <Button fx:id="pushFolderButton"
                    text="Gửi Thư mục (ZIP)"
                    onAction="#handlePushDirectory"/>

            <!-- GÓI 4 (MILESTONE 6): Bộ giới hạn băng thông chủ động (Token Bucket QoS) -->
            <Label text="Giới hạn tốc độ:" style="-fx-font-size: 12px; -fx-font-weight: bold;"/>
            <ComboBox fx:id="bandwidthLimitComboBox"
                      onAction="#handleBandwidthLimitChanged"
                      prefWidth="135"/>

            <Label fx:id="statusLabel" text="Trạng thái: Sẵn sàng" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <ProgressBar fx:id="transferProgressBar" progress="0.0" prefWidth="185"/>
        </HBox>
    </bottom>
</BorderPane>
