<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Main Dashboard: Peer list (left), shared files (center), actions & status (bottom). -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nhannv.p2p.ui.MainController"
            prefWidth="800" prefHeight="600"
            style="-fx-background-color: #f4f6f9; -fx-font-size: 13px;">

    <!-- TOP: Application header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #1f2937;">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Label text="P2P LAN File Sharing"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Label text="Peer-to-Peer • LAN"
                   style="-fx-text-fill: #9ca3af;"/>
        </HBox>
    </top>

    <!-- LEFT: Online peers in the LAN (fixed width) -->
    <left>
        <VBox spacing="8" minWidth="240" prefWidth="240" maxWidth="240"
              style="-fx-background-color: white; -fx-border-color: transparent #e5e7eb transparent transparent;">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="6">
                <Label text="Peers đang online"
                       style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
                <Label fx:id="peerCountLabel" text="(0)"
                       style="-fx-text-fill: #6b7280;"/>
            </HBox>
            <ListView fx:id="peerListView" VBox.vgrow="ALWAYS"/>
        </VBox>
    </left>

    <!-- CENTER: Shared files table (populated in later milestones) -->
    <center>
        <VBox spacing="8">
            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <Label text="Tệp đang chia sẻ"
                   style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TableView fx:id="sharedFileTable" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="fileNameColumn" text="Tên tệp" prefWidth="260"/>
                    <TableColumn fx:id="fileSizeColumn" text="Kích thước" prefWidth="100"/>
                    <TableColumn fx:id="filePathColumn" text="Đường dẫn" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- BOTTOM: Action button, system status, progress -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: white; -fx-border-color: #e5e7eb transparent transparent transparent;">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Button fx:id="chooseFileButton" text="Chọn file"
                    onAction="#onChooseFileClicked" defaultButton="true"/>
            <Label fx:id="statusLabel" text="Trạng thái: Sẵn sàng" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                   style="-fx-text-fill: #4b5563;"/>
            <ProgressBar fx:id="transferProgressBar" progress="0.0" prefWidth="220"/>
        </HBox>
    </bottom>
</BorderPane>
